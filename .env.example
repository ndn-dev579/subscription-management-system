# ========================================================
# Brightloop Subscription Management System — Environment Configuration
# ========================================================

# Django Settings
DJANGO_SECRET_KEY=dev-secret-key-change-this-in-production-brightloop-2026
DJANGO_DEBUG=true
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/subscription_management

# Redis / Celery Broker
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (Vite Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Defaults
DEFAULT_CURRENCY=INR
TIME_ZONE=Asia/Kolkata
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

